# Copy to .env.local and fill in. Never commit real values.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
# Public origin for links that are stored, emailed or shown. Required in production.
APP_URL=
# Web Push (VAPID). Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Zalo bots: secret that encrypts organizers' bot keys (base64, 32 bytes). Generate with: openssl rand -base64 32
ZALO_KEY_SECRET=
# Zalo Bot API base URL; empty uses https://bot-api.zaloplatforms.com
ZALO_BOT_API_URL=
