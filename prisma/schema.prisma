// SwimQuest database schema. Later schema tasks append their models to this file.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum ActorType {
  USER
  SYSTEM
}

model User {
  id               String         @id @default(cuid())
  /// Always stored lower-cased (normalized by the client in src/server/db.ts).
  email            String         @unique
  passwordHash     String
  displayName      String
  status           UserStatus     @default(ACTIVE)
  isPlatformAdmin  Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  auditEvents      AuditEvent[]
  organized        Tournament[]   @relation("OrganizedTournaments")
  captainOf        Team[]         @relation("CaptainedTeams")
  memberships      TeamMember[]
  swims            Swim[]
  swimResults      SwimResult[]
  pointsEntries    PointsEntry[]
  seenMoments      SeenMoment[]
  weeklyResults    WeeklyResult[]
  decidedResults   SwimResult[]   @relation("SwimResultDecisions")
  disputes         Dispute[]      @relation("DisputeOwner")
  decidedDisputes  Dispute[]      @relation("DisputeDecisions")
  helperOf         ReviewHelper[] @relation("ReviewHelperUser")
  appointedHelpers ReviewHelper[] @relation("ReviewHelperAppointer")
  badges           Badge[]        @relation("BadgeOwner")
  givenBadges      Badge[]        @relation("BadgeGiver")
  xpEntries        XpEntry[]
  xpWeeks          XpWeek[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditEvent {
  id           String    @id @default(cuid())
  actorType    ActorType
  actorUserId  String?
  actor        User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String
  tournamentId String?
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime  @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([entityType, entityId])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  /// Stored for later use; in P0 "active" is derived from the season dates.
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StartSetBy {
  CAPTAIN
  ORGANIZER
  AUTOMATIC
}

enum TeamMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum TeamMemberEndReason {
  LEFT
  SWITCHED
  MOVED
  REMOVED_BEFORE_START
  REMOVED_AFTER_START
}

enum SwimTypeAllowed {
  ANY
  POOL_ONLY
  OPEN_WATER_ONLY
}

enum TournamentVisibility {
  PUBLIC
  INVITE_ONLY
}

model Tournament {
  id                         String                @id @default(cuid())
  organizerId                String
  organizer                  User                  @relation("OrganizedTournaments", fields: [organizerId], references: [id])
  name                       String
  description                String
  status                     TournamentStatus      @default(DRAFT)
  seasonStartAt              DateTime              @db.Timestamptz(3)
  seasonEndAt                DateTime              @db.Timestamptz(3)
  /// Route registry id, e.g. "route01".
  routeId                    String
  /// Entered in km in the UI, stored as whole metres.
  routeDistanceM             Int
  fastestPaceSecPer100m      Int                   @default(65)
  slowestPaceSecPer100m      Int                   @default(300)
  longestRealisticSwimM      Int                   @default(30000)
  longestSwimCountedM        Int                   @default(10000)
  dailyLimitM                Int                   @default(10000)
  pointsPerKm                Int                   @default(10)
  /// Null means the season start.
  startChoiceDeadlineAt      DateTime?             @db.Timestamptz(3)
  /// Set when the tournament is published.
  inviteToken                String?               @unique
  publishedAt                DateTime?             @db.Timestamptz(3)
  swimTypeAllowed            SwimTypeAllowed       @default(ANY)
  submissionDays             Int                   @default(7)
  lateUploadDays             Int                   @default(3)
  firstSwimBonusPoints       Int                   @default(20)
  longSwimTier1M             Int                   @default(1000)
  longSwimTier1Points        Int                   @default(10)
  longSwimTier2M             Int                   @default(3000)
  longSwimTier2Points        Int                   @default(25)
  /// Percent values are integers (110 = x1.10) so scoring stays integer math.
  multiplierTwoDaysPct       Int                   @default(110)
  multiplierThreeDaysPct     Int                   @default(120)
  streakStepPct              Int                   @default(5)
  multiplierMaxPct           Int                   @default(140)
  /// Extra rules; null means the rule is off.
  minSwimDistanceM           Int?
  extraSlowestPaceSecPer100m Int?
  /// Snapshot of the admin limit bounds taken when the tournament is created.
  swimLimitBounds            Json?
  /// Null means not chosen yet; behaves as INVITE_ONLY.
  visibility                 TournamentVisibility?
  inviteEnabled              Boolean               @default(true)
  /// Image ids; no foreign key yet.
  bannerImageId              String?
  logoImageId                String?
  rulesUrl                   String?
  eligibilityNotes           String?
  contactChannel             String?
  rulesText                  String?
  archivedAt                 DateTime?             @db.Timestamptz(3)
  seasonEndProcessedAt       DateTime?             @db.Timestamptz(3)
  createdAt                  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @db.Timestamptz(3)
  teams                      Team[]
  members                    TeamMember[]
  swimResults                SwimResult[]
  pointsEntries              PointsEntry[]
  weeklyResults              WeeklyResult[]
  weekSettlements            WeekSettlement[]
  reviewHelpers              ReviewHelper[]
  badges                     Badge[]

  @@index([organizerId])
}

model Team {
  id               String         @id @default(cuid())
  tournamentId     String
  tournament       Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name             String
  emblemKey        String
  description      String?
  /// At least 1 (check constraint "Team_memberLimit_check").
  memberLimit      Int
  captainUserId    String?
  captain          User?          @relation("CaptainedTeams", fields: [captainUserId], references: [id], onDelete: SetNull)
  /// Destination slug from the tournament's route.
  startDestination String?
  startSetAt       DateTime?      @db.Timestamptz(3)
  startSetBy       StartSetBy?
  /// Cached route progress in basis points (10000 = finish), derived from the points ledger.
  progressBp       Int            @default(0)
  finishedAt       DateTime?      @db.Timestamptz(3)
  /// Set when a correction takes the team back below the finish.
  finishLostAt     DateTime?      @db.Timestamptz(3)
  finishLostReason String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  members          TeamMember[]
  swimResults      SwimResult[]
  pointsEntries    PointsEntry[]
  weeklyResults    WeeklyResult[]
  badges           Badge[]

  /// Target of TeamMember's (teamId, tournamentId) foreign key.
  @@unique([id, tournamentId])
  @@index([tournamentId])
}

model TeamMember {
  id           String               @id @default(cuid())
  teamId       String
  /// Always the team's tournament (enforced by the composite foreign key).
  tournamentId String
  team         Team                 @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  status       TeamMemberStatus     @default(ACTIVE)
  joinedAt     DateTime             @default(now()) @db.Timestamptz(3)
  /// Set together with endReason when the membership stops being ACTIVE.
  endedAt      DateTime?            @db.Timestamptz(3)
  endReason    TeamMemberEndReason?

  /// One active team per user per tournament.
  @@unique([tournamentId, userId], map: "TeamMember_one_active_per_tournament", where: raw("\"status\" = 'ACTIVE'"))
  @@index([teamId, status])
  @@index([userId])
}

enum SwimSource {
  GPX
  FIT
}

enum SwimType {
  POOL
  OPEN_WATER
  UNKNOWN
}

enum SwimResultStatus {
  VERIFIED
  FLAGGED
  REJECTED
  DUPLICATE
  DISPUTED
  REVOKED
  RULE_MISSED
}

enum PointsKind {
  DISTANCE
  FIRST_SWIM_BONUS
  LONG_SWIM_BONUS
  WEEKLY_MULTIPLIER
  REVERSAL
}

/// One uploaded activity file. Distances are whole metres, durations whole seconds (>= 0).
model Swim {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  source           SwimSource
  fileSha256       String
  originalFilename String
  startedAt        DateTime     @db.Timestamptz(3)
  endedAt          DateTime     @db.Timestamptz(3)
  distanceM        Int
  durationS        Int
  swimType         SwimType
  /// Sport as reported by the file, e.g. "swimming".
  sport            String
  isSwim           Boolean
  duplicateOfId    String?
  duplicateOf      Swim?        @relation("SwimDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates       Swim[]       @relation("SwimDuplicates")
  /// Private GPS track: never returned to anyone but the owner.
  track            Json?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  results          SwimResult[]
  xpEntries        XpEntry[]

  @@index([userId, startedAt])
  @@index([userId, fileSha256])
}

/// A swim's outcome in one tournament; a swim has at most one result per tournament.
model SwimResult {
  id            String           @id @default(cuid())
  swimId        String
  swim          Swim             @relation(fields: [swimId], references: [id], onDelete: Cascade)
  /// Always the team's tournament (enforced by the composite foreign key).
  tournamentId  String
  tournament    Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team             @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  status        SwimResultStatus
  /// JSON array of reason codes.
  reasons       Json
  countedM      Int              @default(0)
  /// Latest review decision by an organizer or review helper.
  decidedById   String?
  decidedBy     User?            @relation("SwimResultDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?        @db.Timestamptz(3)
  /// Internal reason shown to the swim owner only; never public.
  decisionNote  String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  pointsEntries PointsEntry[]
  disputes      Dispute[]

  @@unique([swimId, tournamentId])
  @@index([tournamentId, status])
}

/// Append-only points ledger: corrections add REVERSAL entries, rows are never edited.
model PointsEntry {
  id           String      @id @default(cuid())
  /// Always the team's tournament (enforced by the composite foreign key).
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  teamId       String
  team         Team        @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  swimResultId String?
  swimResult   SwimResult? @relation(fields: [swimResultId], references: [id], onDelete: NoAction)
  kind         PointsKind
  points       Int
  countedM     Int         @default(0)
  /// Vietnam calendar day "YYYY-MM-DD" (check constraint "PointsEntry_vnDay_check").
  vnDay        String      @db.Char(10)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([swimResultId, kind])
  @@index([tournamentId, userId, vnDay])
  @@index([tournamentId, teamId, createdAt])
}

/// Append-only domain event log. Payloads never hold emails or GPS tracks.
model DomainEvent {
  id           String   @id @default(cuid())
  type         String
  /// No foreign key: events outlive the rows they mention.
  tournamentId String?
  payload      Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([tournamentId, createdAt])
}

/// A "show once" moment the user has already seen, e.g. a finish celebration.
model SeenMoment {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  seenAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, key])
}

/// A player's weekly consistency multiplier result in one tournament.
model WeeklyResult {
  id             String     @id @default(cuid())
  /// Always the team's tournament (enforced by the composite foreign key).
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  teamId         String
  team           Team       @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  /// Monday of the week in Vietnam time, "YYYY-MM-DD" (check constraint "WeeklyResult_weekStart_check").
  weekStart      String     @db.Char(10)
  activeDays     Int
  /// Integer percent, 125 = x1.25.
  multiplierPct  Int
  distancePoints Int
  extraPoints    Int
  streakWeeks    Int
  settledAt      DateTime   @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([tournamentId, userId, weekStart])
}

/// Marks a week as settled so the weekly multiplier runs once per tournament and week.
model WeekSettlement {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Monday of the week in Vietnam time, "YYYY-MM-DD" (check constraint "WeekSettlement_weekStart_check").
  weekStart    String     @db.Char(10)
  settledAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([tournamentId, weekStart])
}

enum DisputeStatus {
  OPEN
  ACCEPTED
  REJECTED
}

/// A player's dispute of a swim result (which is already per tournament).
model Dispute {
  id             String           @id @default(cuid())
  swimResultId   String
  swimResult     SwimResult       @relation(fields: [swimResultId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("DisputeOwner", fields: [userId], references: [id])
  reason         String
  status         DisputeStatus    @default(OPEN)
  /// The result's status before the dispute; restored when the dispute is rejected.
  previousStatus SwimResultStatus
  decidedById    String?
  decidedBy      User?            @relation("DisputeDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?        @db.Timestamptz(3)
  /// Internal reason shown to the swim owner only; never public.
  decisionNote   String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  /// One open dispute per swim result.
  @@unique([swimResultId], map: "Dispute_one_open_per_result", where: raw("\"status\" = 'OPEN'"))
  @@index([swimResultId])
}

/// A player appointed by the organizer to help review swims in one tournament.
model ReviewHelper {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation("ReviewHelperUser", fields: [userId], references: [id])
  appointedById String
  appointedBy   User       @relation("ReviewHelperAppointer", fields: [appointedById], references: [id])
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  removedAt     DateTime?  @db.Timestamptz(3)

  /// One active helper row per player and tournament.
  @@unique([tournamentId, userId], map: "ReviewHelper_one_active_per_tournament", where: raw("\"removedAt\" IS NULL"))
  @@index([userId])
}

enum BadgeKind {
  PARTICIPATION
  EXPLORER
  PERSEVERANCE
  TEAMWORK
  CONQUEROR
  SEASON
  SPECIAL
  LY_SON
}

/// A badge a player earned in one tournament. Removal sets removedAt; rows are never deleted.
model Badge {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation("BadgeOwner", fields: [userId], references: [id])
  /// Team the badge was earned with, if any; the badge stays with the player.
  teamId        String?
  team          Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  kind          BadgeKind
  reason        String?
  /// Organizer who gave a manual badge (e.g. SPECIAL); null for automatic badges.
  givenById     String?
  givenBy       User?      @relation("BadgeGiver", fields: [givenById], references: [id], onDelete: SetNull)
  awardedAt     DateTime   @default(now()) @db.Timestamptz(3)
  removedAt     DateTime?  @db.Timestamptz(3)
  removedReason String?

  /// One active badge of a kind per player and tournament.
  @@unique([tournamentId, userId, kind], map: "Badge_one_active_per_kind", where: raw("\"removedAt\" IS NULL"))
  @@index([userId, awardedAt])
}

enum XpKind {
  DISTANCE
  FIRST_SWIM_BONUS
  LONG_SWIM_BONUS
  WEEKLY_MULTIPLIER
  REVERSAL
}

/// Append-only XP ledger across tournaments: corrections add REVERSAL entries, rows are never edited.
model XpEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  swimId     String?
  swim       Swim?     @relation(fields: [swimId], references: [id], onDelete: NoAction)
  /// Monday of the week in Vietnam time, "YYYY-MM-DD" (check constraint "XpEntry_weekStart_check").
  weekStart  String?   @db.Char(10)
  kind       XpKind
  xp         Int
  /// Vietnam calendar day "YYYY-MM-DD" (check constraint "XpEntry_vnDay_check").
  vnDay      String?   @db.Char(10)
  /// The entry this REVERSAL cancels.
  reversesId String?
  reverses   XpEntry?  @relation("XpReversals", fields: [reversesId], references: [id], onDelete: NoAction)
  reversals  XpEntry[] @relation("XpReversals")
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  /// One entry of a kind per swim; entries without a swim are not constrained (NULLs differ).
  @@unique([swimId, kind])
  @@index([userId])
}

/// A player's settled weekly XP multiplier.
model XpWeek {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  /// Monday of the week in Vietnam time, "YYYY-MM-DD" (check constraint "XpWeek_weekStart_check").
  weekStart     String   @db.Char(10)
  /// Integer percent, 120 = x1.20.
  multiplierPct Int
  extraXp       Int
  settledAt     DateTime @db.Timestamptz(3)

  @@unique([userId, weekStart])
}
