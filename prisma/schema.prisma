// SwimQuest database schema. Later schema tasks append their models to this file.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum ActorType {
  USER
  SYSTEM
}

model User {
  id              String        @id @default(cuid())
  /// Always stored lower-cased (normalized by the client in src/server/db.ts).
  email           String        @unique
  passwordHash    String
  displayName     String
  status          UserStatus    @default(ACTIVE)
  isPlatformAdmin Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  auditEvents     AuditEvent[]
  organized       Tournament[]  @relation("OrganizedTournaments")
  captainOf       Team[]        @relation("CaptainedTeams")
  memberships     TeamMember[]
  swims           Swim[]
  swimResults     SwimResult[]
  pointsEntries   PointsEntry[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditEvent {
  id           String    @id @default(cuid())
  actorType    ActorType
  actorUserId  String?
  actor        User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String
  tournamentId String?
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime  @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([entityType, entityId])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  /// Stored for later use; in P0 "active" is derived from the season dates.
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StartSetBy {
  CAPTAIN
  ORGANIZER
  AUTOMATIC
}

enum TeamMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum SwimTypeAllowed {
  ANY
  POOL_ONLY
  OPEN_WATER_ONLY
}

enum TournamentVisibility {
  PUBLIC
  INVITE_ONLY
}

model Tournament {
  id                         String                @id @default(cuid())
  organizerId                String
  organizer                  User                  @relation("OrganizedTournaments", fields: [organizerId], references: [id])
  name                       String
  description                String
  status                     TournamentStatus      @default(DRAFT)
  seasonStartAt              DateTime              @db.Timestamptz(3)
  seasonEndAt                DateTime              @db.Timestamptz(3)
  /// Route registry id, e.g. "route01".
  routeId                    String
  /// Entered in km in the UI, stored as whole metres.
  routeDistanceM             Int
  fastestPaceSecPer100m      Int                   @default(65)
  slowestPaceSecPer100m      Int                   @default(300)
  longestRealisticSwimM      Int                   @default(30000)
  longestSwimCountedM        Int                   @default(10000)
  dailyLimitM                Int                   @default(10000)
  pointsPerKm                Int                   @default(10)
  /// Null means the season start.
  startChoiceDeadlineAt      DateTime?             @db.Timestamptz(3)
  /// Set when the tournament is published.
  inviteToken                String?               @unique
  publishedAt                DateTime?             @db.Timestamptz(3)
  swimTypeAllowed            SwimTypeAllowed       @default(ANY)
  submissionDays             Int                   @default(7)
  lateUploadDays             Int                   @default(3)
  firstSwimBonusPoints       Int                   @default(20)
  longSwimTier1M             Int                   @default(1000)
  longSwimTier1Points        Int                   @default(10)
  longSwimTier2M             Int                   @default(3000)
  longSwimTier2Points        Int                   @default(25)
  /// Percent values are integers (110 = x1.10) so scoring stays integer math.
  multiplierTwoDaysPct       Int                   @default(110)
  multiplierThreeDaysPct     Int                   @default(120)
  streakStepPct              Int                   @default(5)
  multiplierMaxPct           Int                   @default(140)
  /// Extra rules; null means the rule is off.
  minSwimDistanceM           Int?
  extraSlowestPaceSecPer100m Int?
  /// Snapshot of the admin limit bounds taken when the tournament is created.
  swimLimitBounds            Json?
  /// Null means not chosen yet; behaves as INVITE_ONLY.
  visibility                 TournamentVisibility?
  inviteEnabled              Boolean               @default(true)
  /// Image ids; no foreign key yet.
  bannerImageId              String?
  logoImageId                String?
  rulesUrl                   String?
  eligibilityNotes           String?
  contactChannel             String?
  rulesText                  String?
  archivedAt                 DateTime?             @db.Timestamptz(3)
  seasonEndProcessedAt       DateTime?             @db.Timestamptz(3)
  createdAt                  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @db.Timestamptz(3)
  teams                      Team[]
  members                    TeamMember[]
  swimResults                SwimResult[]
  pointsEntries              PointsEntry[]

  @@index([organizerId])
}

model Team {
  id               String        @id @default(cuid())
  tournamentId     String
  tournament       Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name             String
  emblemKey        String
  description      String?
  /// At least 1 (check constraint "Team_memberLimit_check").
  memberLimit      Int
  captainUserId    String?
  captain          User?         @relation("CaptainedTeams", fields: [captainUserId], references: [id], onDelete: SetNull)
  /// Destination slug from the tournament's route.
  startDestination String?
  startSetAt       DateTime?     @db.Timestamptz(3)
  startSetBy       StartSetBy?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  members          TeamMember[]
  swimResults      SwimResult[]
  pointsEntries    PointsEntry[]

  /// Target of TeamMember's (teamId, tournamentId) foreign key.
  @@unique([id, tournamentId])
  @@index([tournamentId])
}

model TeamMember {
  id           String           @id @default(cuid())
  teamId       String
  /// Always the team's tournament (enforced by the composite foreign key).
  tournamentId String
  team         Team             @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  status       TeamMemberStatus @default(ACTIVE)
  joinedAt     DateTime         @default(now()) @db.Timestamptz(3)

  /// One active team per user per tournament.
  @@unique([tournamentId, userId], map: "TeamMember_one_active_per_tournament", where: raw("\"status\" = 'ACTIVE'"))
  @@index([teamId, status])
  @@index([userId])
}

enum SwimSource {
  GPX
  FIT
}

enum SwimType {
  POOL
  OPEN_WATER
  UNKNOWN
}

enum SwimResultStatus {
  VERIFIED
  FLAGGED
  REJECTED
  DUPLICATE
  DISPUTED
  REVOKED
  RULE_MISSED
}

enum PointsKind {
  DISTANCE
  FIRST_SWIM_BONUS
  LONG_SWIM_BONUS
  WEEKLY_MULTIPLIER
  REVERSAL
}

/// One uploaded activity file. Distances are whole metres, durations whole seconds (>= 0).
model Swim {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  source           SwimSource
  fileSha256       String
  originalFilename String
  startedAt        DateTime     @db.Timestamptz(3)
  endedAt          DateTime     @db.Timestamptz(3)
  distanceM        Int
  durationS        Int
  swimType         SwimType
  /// Sport as reported by the file, e.g. "swimming".
  sport            String
  isSwim           Boolean
  duplicateOfId    String?
  duplicateOf      Swim?        @relation("SwimDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates       Swim[]       @relation("SwimDuplicates")
  /// Private GPS track: never returned to anyone but the owner.
  track            Json?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  results          SwimResult[]

  @@index([userId, startedAt])
  @@index([userId, fileSha256])
}

/// A swim's outcome in one tournament; a swim has at most one result per tournament.
model SwimResult {
  id            String           @id @default(cuid())
  swimId        String
  swim          Swim             @relation(fields: [swimId], references: [id], onDelete: Cascade)
  /// Always the team's tournament (enforced by the composite foreign key).
  tournamentId  String
  tournament    Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team             @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  status        SwimResultStatus
  /// JSON array of reason codes.
  reasons       Json
  countedM      Int              @default(0)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  pointsEntries PointsEntry[]

  @@unique([swimId, tournamentId])
  @@index([tournamentId, status])
}

/// Append-only points ledger: corrections add REVERSAL entries, rows are never edited.
model PointsEntry {
  id           String      @id @default(cuid())
  /// Always the team's tournament (enforced by the composite foreign key).
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  teamId       String
  team         Team        @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  swimResultId String?
  swimResult   SwimResult? @relation(fields: [swimResultId], references: [id], onDelete: NoAction)
  kind         PointsKind
  points       Int
  countedM     Int         @default(0)
  /// Vietnam calendar day "YYYY-MM-DD" (check constraint "PointsEntry_vnDay_check").
  vnDay        String      @db.Char(10)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([swimResultId, kind])
  @@index([tournamentId, userId, vnDay])
  @@index([tournamentId, teamId, createdAt])
}
